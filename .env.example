# Contact Enrichment
HUNTER_API_KEY=your-hunter-api-key   # https://hunter.io — free tier: 25 finds/mo

# Website Visitor ID
IPINFO_TOKEN=your-ipinfo-token       # https://ipinfo.io — free tier: 50k lookups/mo

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Socket.io Configuration (for real-time features)
VITE_SOCKET_IO_URL=http://localhost:3000

# Backend API URL (for email and AI features)
VITE_BACKEND_URL=http://localhost:3000

# Twilio Click-to-Call (backend only — add to public_html/backend/.env)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX   # Purchased/verified Twilio number
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # TwiML App SID from Twilio Console

# Autopilot Cron Thresholds (backend only — add to public_html/backend/.env)
SIGNAL_MIN_SCORE=30                      # Signals below this score are auto-dismissed (0-100)
KPI_ANOMALY_WARNING_THRESHOLD=-30        # % drop from 4-week avg to trigger warning alert
KPI_ANOMALY_CRITICAL_THRESHOLD=-50       # % drop from 4-week avg to trigger critical + admin alert
ACTION_QUEUE_MAX_PER_ORG=10              # Max AI-drafted outreach items queued per org per scan

# Backend Supabase credentials (add to public_html/backend/.env — NOT the frontend .env)
# These are required for the Node.js backend's admin cron jobs and auth middleware.
SUPABASE_URL=your-supabase-project-url           # Project Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Project Settings → API → service_role (secret!)
ANTHROPIC_API_KEY=your-anthropic-api-key         # https://console.anthropic.com

# ── Integration Framework (backend only — add to public_html/backend/.env) ──
# Encryption key for OAuth tokens stored in DB (generate: openssl rand -hex 32)
INTEGRATION_ENCRYPTION_KEY=
FRONTEND_URL=https://apptivia.app
BACKEND_URL=https://apptivia.app

# Salesforce Connected App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot App
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Outreach.io App
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=

# SalesLoft App
SALESLOFT_CLIENT_ID=
SALESLOFT_CLIENT_SECRET=

# Marketo (client credentials — no OAuth popup)
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
MARKETO_MUNCHKIN_ID=

# Microsoft Azure AD App (for Outlook Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google Cloud Console App (for Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Alternative environment variable names (legacy support)
# REACT_APP_SUPABASE_URL=your-supabase-url
# REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key
# REACT_APP_SOCKET_IO_URL=http://localhost:3000
# REACT_APP_BACKEND_URL=http://localhost:3000
# SUPABASE_KEY=your-supabase-anon-key
