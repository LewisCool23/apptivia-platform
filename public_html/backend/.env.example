# Example environment variables
PORT=3000
CORS_ORIGIN=http://localhost:3001
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
# Service role key — required for JWT verification (auth middleware)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Apptivia Platform <noreply@apptivia.app>"

# Anthropic (Claude) API Key for AI Drafting
ANTHROPIC_API_KEY=your-anthropic-api-key

# Outreach.io Webhook Integration
# Set this to the signing secret from Outreach Settings → Webhooks
# Leave blank to skip HMAC verification (not recommended for production)
OUTREACH_WEBHOOK_SECRET=
