RewriteEngine On
RewriteBase /

# Serve .md files as plain text so AI crawlers can read them
AddType text/plain .md

# Proxy /api/ and /track/ and /socket.io/ to Node.js backend
RewriteCond %{REQUEST_URI} ^/(api|track|socket\.io)(/|$)
RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]

# React SPA — all other routes serve index.html
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── Caching ──────────────────────────────────────────────────────────────────

# Never cache index.html so browsers always get the latest build
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# Vite hashed assets — immutable, cache for 1 year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable gzip compression (if not already enabled by Hostinger)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
